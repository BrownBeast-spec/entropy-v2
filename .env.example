# Google Gemini API key for LLM integration
GOOGLE_GENERATIVE_AI_API_KEY=

# NCBI/PubMed API credentials
NCBI_API_KEY=
NCBI_EMAIL=

# OpenFDA API key
OPENFDA_API_KEY=

# PostgreSQL connection string (required for audit trail features)
DATABASE_URL=postgresql://entropy:entropy@localhost:5432/entropy

# ─── LLM Configuration ─────────────────────────────────────────────────
# Default model for all agents (format: provider:model-name)
# Supported providers: google, openai, anthropic, perplexity, huggingface, openrouter
# LLM_MODEL=google:gemini-2.5-flash

# Per-agent model overrides (optional — falls back to LLM_MODEL)
# PLANNER_MODEL=openai:gpt-4o
# BIOLOGIST_MODEL=google:gemini-2.5-flash
# CLINICAL_SCOUT_MODEL=anthropic:claude-sonnet-4-20250514
# HAWK_SAFETY_MODEL=google:gemini-2.5-flash
# LIBRARIAN_MODEL=google:gemini-2.5-flash
# GAP_ANALYST_MODEL=openai:gpt-4o
# VERIFIER_MODEL=anthropic:claude-sonnet-4-20250514
# QUERY_PLANNER_MODEL=google:gemini-2.5-flash
# EVIDENCE_SUMMARIZER_MODEL=google:gemini-2.5-flash

# OpenAI API key (required if using openai: provider)
# OPENAI_API_KEY=

# Anthropic API key (required if using anthropic: provider)
# ANTHROPIC_API_KEY=

# Hugging Face API key (required if using huggingface: provider)
# HUGGINGFACE_API_KEY=

# OpenRouter API key (required if using openrouter: provider)
# OPENROUTER_API_KEY=

# ─── Neo4j Configuration ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=entropy-graph-2024

# ─── NVIDIA NIM Configuration ───────────────────────────────────────────
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=openai/gpt-oss-120b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Rate limiting for NVIDIA NIM API
NVIDIA_NIM_MAX_RPM=60
NVIDIA_NIM_MAX_TPM=90000
NVIDIA_NIM_MAX_CONCURRENT=3

# ─── OpenTelemetry Configuration ────────────────────────────────────────
# Exporter type: otlp, console, memory, none (default: none)
# OTEL_EXPORTER=none
# OTLP endpoint (default: http://localhost:4318/v1/traces)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Service name for traces
# OTEL_SERVICE_NAME=entropy-research
